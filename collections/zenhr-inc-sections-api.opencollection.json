{
  "opencollection": "1.0.0",
  "info": {
    "name": "ZenHR Approvals Sections API",
    "version": "v3"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://api.zenhr.com/en/oauth/authorize",
      "accessTokenUrl": "https://api.zenhr.com/en/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Sections",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Sections",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.zenhr.com/api/v3/branches/:branch_id/sections",
            "params": [
              {
                "name": "branch_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "List Sections"
        },
        {
          "info": {
            "name": "Create Section",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.zenhr.com/api/v3/branches/:branch_id/sections",
            "params": [
              {
                "name": "branch_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Create Section"
        },
        {
          "info": {
            "name": "Get Section",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.zenhr.com/api/v3/branches/:branch_id/sections/:section_id",
            "params": [
              {
                "name": "branch_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "section_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get Section"
        },
        {
          "info": {
            "name": "Update Section",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://app.zenhr.com/api/v3/branches/:branch_id/sections/:section_id",
            "params": [
              {
                "name": "branch_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "section_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Update Section"
        },
        {
          "info": {
            "name": "Delete Section",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://app.zenhr.com/api/v3/branches/:branch_id/sections/:section_id",
            "params": [
              {
                "name": "branch_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "section_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete Section"
        }
      ]
    }
  ],
  "bundled": true
}