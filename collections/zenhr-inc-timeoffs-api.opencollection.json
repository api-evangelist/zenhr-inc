{
  "opencollection": "1.0.0",
  "info": {
    "name": "ZenHR Approvals Timeoffs API",
    "version": "v3"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://api.zenhr.com/en/oauth/authorize",
      "accessTokenUrl": "https://api.zenhr.com/en/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Timeoffs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Timeoffs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.zenhr.com/api/v3/branches/:branch_id/timeoffs",
            "params": [
              {
                "name": "branch_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "List Timeoffs"
        },
        {
          "info": {
            "name": "Get Timeoff",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.zenhr.com/api/v3/branches/:branch_id/timeoffs/:timeoff_id",
            "params": [
              {
                "name": "branch_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "timeoff_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get Timeoff"
        }
      ]
    }
  ],
  "bundled": true
}