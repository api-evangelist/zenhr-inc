{
  "opencollection": "1.0.0",
  "info": {
    "name": "ZenHR Approvals Families API",
    "version": "v3"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://api.zenhr.com/en/oauth/authorize",
      "accessTokenUrl": "https://api.zenhr.com/en/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Families",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Employee Families",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.zenhr.com/api/v3/branches/:branch_id/employees/:employee_id/families",
            "params": [
              {
                "name": "branch_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "employee_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "List Employee Families"
        },
        {
          "info": {
            "name": "Create Family",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.zenhr.com/api/v3/branches/:branch_id/employees/:employee_id/families",
            "params": [
              {
                "name": "branch_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "employee_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Create Family"
        },
        {
          "info": {
            "name": "Show Family",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.zenhr.com/api/v3/branches/:branch_id/employees/:employee_id/families/:family_id",
            "params": [
              {
                "name": "branch_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "employee_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "family_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Show Family"
        },
        {
          "info": {
            "name": "Update Family",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://app.zenhr.com/api/v3/branches/:branch_id/employees/:employee_id/families/:family_id",
            "params": [
              {
                "name": "branch_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "employee_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "family_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Update Family"
        },
        {
          "info": {
            "name": "Delete Family",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://app.zenhr.com/api/v3/branches/:branch_id/employees/:employee_id/families/:family_id",
            "params": [
              {
                "name": "branch_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "employee_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "family_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete Family"
        }
      ]
    }
  ],
  "bundled": true
}