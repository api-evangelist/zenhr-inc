{
  "opencollection": "1.0.0",
  "info": {
    "name": "ZenHR Approvals Timeoff Transaction API",
    "version": "v3"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://api.zenhr.com/en/oauth/authorize",
      "accessTokenUrl": "https://api.zenhr.com/en/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Timeoff Transaction",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Timeoff Transactions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.zenhr.com/api/v3/branches/:branch_id/timeoff_transactions",
            "params": [
              {
                "name": "branch_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "List Timeoff Transactions"
        },
        {
          "info": {
            "name": "Get Timeoff Transaction",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.zenhr.com/api/v3/branches/:branch_id/timeoff_transactions/:timeoff_transaction_id",
            "params": [
              {
                "name": "branch_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "timeoff_transaction_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get Timeoff Transaction"
        },
        {
          "info": {
            "name": "Create Timeoff Transaction Request",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.zenhr.com/api/v3/branches/:branch_id/timeoff_transaction_requests/:timeoff_transaction_request_id",
            "params": [
              {
                "name": "branch_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "timeoff_transaction_request_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Create Timeoff Transaction Request"
        }
      ]
    }
  ],
  "bundled": true
}