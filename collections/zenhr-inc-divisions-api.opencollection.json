{
  "opencollection": "1.0.0",
  "info": {
    "name": "ZenHR Approvals Divisions API",
    "version": "v3"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://api.zenhr.com/en/oauth/authorize",
      "accessTokenUrl": "https://api.zenhr.com/en/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Divisions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Divisions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.zenhr.com/api/v3/branches/:branch_id/divisions",
            "params": [
              {
                "name": "branch_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "List Divisions"
        },
        {
          "info": {
            "name": "Create Division",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.zenhr.com/api/v3/branches/:branch_id/divisions",
            "params": [
              {
                "name": "branch_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Create Division"
        },
        {
          "info": {
            "name": "Show Division",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.zenhr.com/api/v3/branches/:branch_id/divisions/:division_id",
            "params": [
              {
                "name": "branch_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "division_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Show Division"
        },
        {
          "info": {
            "name": "Delete Division",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://app.zenhr.com/api/v3/branches/:branch_id/divisions/:division_id",
            "params": [
              {
                "name": "branch_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "division_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete Division"
        }
      ]
    }
  ],
  "bundled": true
}