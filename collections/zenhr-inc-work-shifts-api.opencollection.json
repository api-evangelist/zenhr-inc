{
  "opencollection": "1.0.0",
  "info": {
    "name": "ZenHR Approvals Work Shifts API",
    "version": "v3"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://api.zenhr.com/en/oauth/authorize",
      "accessTokenUrl": "https://api.zenhr.com/en/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Work Shifts",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Branch Work Shift",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.zenhr.com/api/v3/branches/:branch_id/work_shifts",
            "params": [
              {
                "name": "branch_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "List Branch Work Shift"
        },
        {
          "info": {
            "name": "Create Branch Work Shift",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.zenhr.com/api/v3/branches/:branch_id/work_shifts",
            "params": [
              {
                "name": "branch_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Create Branch Work Shift"
        },
        {
          "info": {
            "name": "Show  Branch Work Shift",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.zenhr.com/api/v3/branches/:branch_id/work_shifts/:work_shift_id",
            "params": [
              {
                "name": "branch_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "work_shift_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Show  Branch Work Shift"
        },
        {
          "info": {
            "name": "Update Branch Work Shift",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://app.zenhr.com/api/v3/branches/:branch_id/work_shifts/:work_shift_id",
            "params": [
              {
                "name": "branch_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "work_shift_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Update Branch Work Shift"
        },
        {
          "info": {
            "name": "Destroy Branch Work Shift",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://app.zenhr.com/api/v3/branches/:branch_id/work_shifts/:work_shift_id",
            "params": [
              {
                "name": "branch_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "work_shift_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Destroy Branch Work Shift"
        }
      ]
    }
  ],
  "bundled": true
}