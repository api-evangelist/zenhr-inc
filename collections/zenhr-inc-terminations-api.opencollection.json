{
  "opencollection": "1.0.0",
  "info": {
    "name": "ZenHR Approvals Terminations API",
    "version": "v3"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://api.zenhr.com/en/oauth/authorize",
      "accessTokenUrl": "https://api.zenhr.com/en/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Terminations",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Branch Terminations",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.zenhr.com/api/v3/branches/:branch_id/terminations",
            "params": [
              {
                "name": "branch_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "List Branch Terminations"
        },
        {
          "info": {
            "name": "Create Termination",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.zenhr.com/api/v3/branches/:branch_id/terminations",
            "params": [
              {
                "name": "branch_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Create Termination"
        },
        {
          "info": {
            "name": "Show Branch Termination",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.zenhr.com/api/v3/branches/:branch_id/terminations/:termination_id",
            "params": [
              {
                "name": "branch_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "termination_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Show Branch Termination"
        },
        {
          "info": {
            "name": "Delete Termination",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://app.zenhr.com/api/v3/branches/:branch_id/terminations/:termination_id",
            "params": [
              {
                "name": "branch_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "termination_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete Termination"
        }
      ]
    }
  ],
  "bundled": true
}