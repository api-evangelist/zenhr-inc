{
  "opencollection": "1.0.0",
  "info": {
    "name": "ZenHR Approvals Salaries API",
    "version": "v3"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://api.zenhr.com/en/oauth/authorize",
      "accessTokenUrl": "https://api.zenhr.com/en/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Salaries",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Employee Salary",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.zenhr.com/api/v3/branches/:branch_id/employees/:employee_id/salaries",
            "params": [
              {
                "name": "branch_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "employee_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get Employee Salary"
        },
        {
          "info": {
            "name": "Update Salary Financial Integration Status",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://app.zenhr.com/api/v3/branches/:branch_id/salaries/:salary_id",
            "params": [
              {
                "name": "branch_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "salary_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Update Salary Financial Integration Status"
        }
      ]
    }
  ],
  "bundled": true
}