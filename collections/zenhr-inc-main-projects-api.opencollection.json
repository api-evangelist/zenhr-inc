{
  "opencollection": "1.0.0",
  "info": {
    "name": "ZenHR Approvals Main Projects API",
    "version": "v3"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://api.zenhr.com/en/oauth/authorize",
      "accessTokenUrl": "https://api.zenhr.com/en/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Main Projects",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Main Projects",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.zenhr.com/api/v3/branches/:branch_id/main_projects",
            "params": [
              {
                "name": "branch_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "List Main Projects"
        },
        {
          "info": {
            "name": "Get Main Project",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.zenhr.com/api/v3/branches/:branch_id/main_projects/:main_project_id",
            "params": [
              {
                "name": "branch_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "main_project_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get Main Project"
        },
        {
          "info": {
            "name": "Create Main Project",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.zenhr.com/api/v3/branches/:branch_id/main_projects/:main_project_id",
            "params": [
              {
                "name": "branch_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "main_project_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Create Main Project"
        },
        {
          "info": {
            "name": "Delete Main Project",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://app.zenhr.com/api/v3/branches/:branch_id/main_projects/:main_project_id",
            "params": [
              {
                "name": "branch_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "main_project_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete Main Project"
        }
      ]
    }
  ],
  "bundled": true
}