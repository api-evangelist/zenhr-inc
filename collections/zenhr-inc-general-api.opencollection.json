{
  "opencollection": "1.0.0",
  "info": {
    "name": "ZenHR Approvals General API",
    "version": "v3"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://api.zenhr.com/en/oauth/authorize",
      "accessTokenUrl": "https://api.zenhr.com/en/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "General",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "company",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.zenhr.com/api/v3/company"
          },
          "docs": "company"
        },
        {
          "info": {
            "name": "who am i",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.zenhr.com/api/v3/who_am_i"
          },
          "docs": "who am i"
        }
      ]
    }
  ],
  "bundled": true
}