{
  "opencollection": "1.0.0",
  "info": {
    "name": "ZenHR Approvals Employees API",
    "version": "v3"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://api.zenhr.com/en/oauth/authorize",
      "accessTokenUrl": "https://api.zenhr.com/en/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Employees",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Employee by GL_ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.zenhr.com/api/v3/branches/:branch_id/integration_maps/employee/:global_id",
            "params": [
              {
                "name": "branch_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "global_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get Employee by GL_ID"
        },
        {
          "info": {
            "name": "Update Employee by GL_ID",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://app.zenhr.com/api/v3/branches/:branch_id/integration_maps/employee/:global_id",
            "params": [
              {
                "name": "branch_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "global_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Update Employee by GL_ID"
        }
      ]
    }
  ],
  "bundled": true
}